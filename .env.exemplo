# ============================================================
# Copie este arquivo para ".env" antes de subir o projeto:
#   cp .env.example .env
#
# Crie sua chave em https://openrouter.ai/settings/keys
# (não precisa de cartão para criar a conta e gerar a chave)
# ============================================================

OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui

# Modelo de embeddings (transforma texto em vetor)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Modelo de chat usado no n8n para gerar a resposta final
# Evite modelos ":free" em turmas grandes (limite de ~50 req/dia
# compartilhado). Estes são baratos (centavos por milhão de tokens):
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Qdrant ---------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documentos_curso

# --- Chunking ---------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
